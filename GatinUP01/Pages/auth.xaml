<Page x:Class="GatinUP01.Pages.auth"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GatinUP01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="960"
      Title="auth">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Rectangle Grid.Row="0" Fill="LightGray" HorizontalAlignment="Stretch"/>

        <Label Content="Авторизация"
               Grid.Row="0" 
               Height="40" Width="320"
               FontSize="20"
               HorizontalContentAlignment="Center"
               VerticalContentAlignment="Center"/>

        <TextBox x:Name="Input_Login"
                 HorizontalAlignment="Left" 
                 FontSize="16" 
                 Margin="200,256,0,0" 
                 Grid.Row="1" 
                 TextWrapping="Wrap" 
                 Text="" 
                 VerticalAlignment="Top" 
                 Width="275" Height="42"
                 VerticalContentAlignment="Center"/>

        <TextBox x:Name="Input_Password"
                 HorizontalAlignment="Left" 
                 FontSize="16" 
                 Grid.Row="1" 
                 TextWrapping="Wrap" 
                 Text="" 
                 VerticalAlignment="Top" 
                 Width="275" Height="42" 
                 Margin="200,335,0,0"
                 VerticalContentAlignment="Center"/>

        <Label Content="Логин" 
               HorizontalAlignment="Left" 
               Margin="200,225,0,0" 
               Grid.Row="1" 
               VerticalAlignment="Top" 
               Width="275"/>

        <Label Content="Пароль" 
               HorizontalAlignment="Left" 
               Margin="200,304,0,0" 
               Grid.Row="1" 
               VerticalAlignment="Top" 
               Width="275"/>

        <Button x:Name="Button_Enter"
                ToolTip="Войти в систему"
                Content="Войти" 
                FontSize="16"
                HorizontalAlignment="Center" 
                Margin="0,445,0,0" 
                Grid.Row="1" 
                VerticalAlignment="Top" 
                Height="50" Width="560" Click="Button_Enter_Click"/>

        <Button x:Name="Button_Register"
                ToolTip="Переход на страницу регистрации"
                Content="Регистрация" 
                FontSize="16"
                HorizontalAlignment="Center" 
                Margin="0,500,0,0" 
                Grid.Row="1" 
                VerticalAlignment="Top" 
                Height="50" Width="560" Click="Button_Register_Click"/>
        
        

        <TextBox x:Name="CaptchaField" 
                 HorizontalAlignment="Left" 
                 HorizontalContentAlignment="Right" 
                 VerticalContentAlignment="Center" 
                 FontSize="16" 
                 Margin="487,335,0,0" 
                 Grid.Row="1" 
                 TextWrapping="Wrap" 
                 Text="" 
                 VerticalAlignment="Top" 
                 Width="273" 
                 Height="42"/>

        <Label x:Name="CptchName"
               Content="Captcha" 
               HorizontalAlignment="Left" 
               HorizontalContentAlignment="Right"
               Margin="485,304,0,0" 
               Grid.Row="1" 
               VerticalAlignment="Top" 
               Width="275"/>

        <Label x:Name="Cptch" 
               Content="Label" 
               HorizontalContentAlignment="Right" 
               HorizontalAlignment="Left" 
               Margin="487,256,0,0" 
               Grid.Row="1" 
               VerticalAlignment="Top" 
               Width="273" 
               Height="42"
               VerticalContentAlignment="Center"
               FontSize="16"/>
    </Grid>
</Page>
