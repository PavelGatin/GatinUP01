<Page x:Class="GatinUP01.Pages.auth"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GatinUP01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="960"
      Title="auth">

    <Grid Background="LightGray">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label Content="Авторизация"
               Grid.Row="0" 
               Height="40" Width="320"
               FontSize="20"
               HorizontalContentAlignment="Center"
               VerticalContentAlignment="Center"/>
        <Rectangle Grid.Row="1" Fill="Gray" Height="1" HorizontalAlignment="Stretch"/>

        <TextBox x:Name="Input_Login"
                 HorizontalAlignment="Center" 
                 FontSize="16" 
                 Margin="0,254,0,0" 
                 Grid.Row="2" 
                 TextWrapping="Wrap" 
                 Text="Логин" 
                 VerticalAlignment="Top" 
                 Width="560" Height="42"/>

        <TextBox x:Name="Input_Password"
                 HorizontalAlignment="Center" 
                 FontSize="16" 
                 Grid.Row="2" 
                 TextWrapping="Wrap" 
                 Text="Пароль" 
                 VerticalAlignment="Top" 
                 Width="560" Height="42" 
                 Margin="0,335,0,0"/>

        <Button x:Name="Button_Enter"
                Content="Войти" 
                FontSize="16"
                HorizontalAlignment="Center" 
                Margin="0,445,0,0" 
                Grid.Row="2" 
                VerticalAlignment="Top" 
                Height="50" Width="560" Click="Button_Enter_Click"/>

        <Button x:Name="Button_Register"
                Content="Регистрация" 
                FontSize="16"
                HorizontalAlignment="Center" 
                Margin="0,500,0,0" 
                Grid.Row="2" 
                VerticalAlignment="Top" 
                Height="50" Width="560" Click="Button_Register_Click"/>
        <TextBox x:Name="CaptchaField" HorizontalAlignment="Left" HorizontalContentAlignment="Right" Margin="620,185,0,0" Grid.Row="2" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="140" Height="32"/>
        <Label x:Name="Cptch" Content="Label" HorizontalContentAlignment="Right" HorizontalAlignment="Left" Margin="651,154,0,0" Grid.Row="2" VerticalAlignment="Top" Width="109"/>
    </Grid>
</Page>
