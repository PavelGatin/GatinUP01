<Page x:Class="GatinUP01.Pages.main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GatinUP01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="960"
      Title="main">

    <Grid Background="White">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Rectangle Fill="LightGray"  Stroke="Black" Grid.Row="0" Grid.ColumnSpan="2"/>
        <Rectangle Fill="Gray" Grid.Column="1" Stroke="Black" Grid.RowSpan="2"/>

        <ListBox Name="MyListBox" Grid.Row="1" Grid.Column="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Border создает красивую рамку вокруг нашей ячейки-карточки -->
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10" Width="230">
                        <!-- Grid делит ячейку на колонки: для картинки и для текста с кнопками -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <!-- Колонка для фото -->
                                <ColumnDefinition Width="*" />
                                <!-- Колонка для данных -->
                            </Grid.ColumnDefinitions>

                            <!-- 1. Картинка (Binding ведет на свойство ImagePath в вашем C#-классе) -->
                            <Image Source="{Binding ImagePath}" Width="80" Height="80" Margin="0,0,10,0" VerticalAlignment="Top"/>

                            <!-- 2. Блок с текстом и кнопками справа от картинки -->
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <!-- Строка 1: Заголовок -->
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                                <!-- Строка 2: Подзаголовок / Описание -->
                                <TextBlock Text="{Binding Description}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <!-- Строка 3: Панель управления (кнопки) -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Подробности" Margin="0,0,5,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button x:Name="Button_AddDevice"
                Grid.Column="1"
                Grid.Row="0"
                Margin="5"
                Content="Добавить устройство" Click="Button_AddDevice_Click"/>
        <Label x:Name="Username" 
               Content="Username" 
               HorizontalAlignment="Left" 
               Margin="51,0,0,0" 
               FontSize="20"
               VerticalContentAlignment="Center"
               VerticalAlignment="Center" 
               Width="304" 
               Height="42"/>

        <TabControl Grid.Row="1" Grid.Column="0">
            <TabItem Header="Все">
                <Grid Background="#FFE5E5E5">
                    
                </Grid>
            </TabItem>
            <TabItem Header="Камера">
                <Grid Background="#FFE5E5E5"/>
            </TabItem>
        </TabControl>


        <Button Grid.Column="0" 
                HorizontalAlignment="Left" 
                Height="42" 
                VerticalAlignment="Center" 
                Width="42" Margin="4,0,0,0">
            <Image Source="/Icons/user.png"/>
        </Button>

        <Button Grid.Column="0" 
                HorizontalAlignment="Right" 
                Height="42" 
                VerticalAlignment="Center" 
                Width="42" Margin="0,0,4,0">
            <Image Source="/Icons/settings.png"/>
        </Button>


    </Grid>
</Page>
