<Page x:Class="GatinUP01.Pages.main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GatinUP01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="960"
      Title="main">

    <Grid Background="White">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Rectangle Fill="LightGray"  Stroke="Black" Grid.Row="0" Grid.ColumnSpan="2"/>
        <Rectangle Fill="Gray" Grid.Column="1" Stroke="Black" Grid.RowSpan="2"/>

        <ListBox Name="SensorPanel" Grid.Row="1" Grid.Column="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10" Width="230">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Image Source="/Icons/sensors.png" Width="80" Height="80" Margin="0,0,10,0" VerticalAlignment="Top"/>

                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Place}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding Status}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button ToolTip="Показать полную информацию о датчике" Content="Подробности" Margin="0,0,5,0" Click="OpenSensor"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button x:Name="Button_AddDevice"
                ToolTip="Добавление устройств (доступно только администратору)"
                Grid.Column="1"
                Grid.Row="0"
                Margin="5"
                Content="Добавить устройство" Click="Button_AddDevice_Click"/>
        <Label x:Name="Username" 
               Content="Username" 
               HorizontalAlignment="Left" 
               Margin="51,0,0,0" 
               FontSize="20"
               VerticalContentAlignment="Center"
               VerticalAlignment="Center" 
               Width="304" 
               Height="42"/>



        <ListBox Name="DevicePanel" Grid.Row="1" Grid.Column="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" Margin="8" Padding="10" Width="150" Height="215" Background="White">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="75"/>
                            </Grid.RowDefinitions>

                            <Image Source="/Icons/devices.png" Grid.Row="1" Width="70" Height="70" Margin="0,0,10,0" VerticalAlignment="Top" Stretch="UniformToFill"/>
                            <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            
                            <TextBlock Grid.Row="0" Text="{Binding Place}" Margin="0,15,0,0" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            
                            <StackPanel Grid.Row="2" Orientation="Vertical" >
                                <TextBlock Text="{Binding Status}" Foreground="Gray" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,0" TextTrimming="CharacterEllipsis"/>
                                <Button Content="Запустить" ToolTip="Запустить процесс работы устройства" Width="90" Margin="0,10,0,0" Click="ActivateDevice"/>
                                <Button Content="Подробности" ToolTip="Полная информация об устройстве" Width="90" Margin="0,5,0,0" Click="InfoDevice"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>



        <Button x:Name="Button_Profile"
                ToolTip="Профиль пользователя"
                Grid.Column="0" 
                HorizontalAlignment="Left" 
                Height="42" 
                VerticalAlignment="Center" 
                Width="42" Margin="4,0,0,0" Click="Button_Profile_Click">
            <Image Source="/Icons/user.png"/>
        </Button>
    </Grid>
</Page>
