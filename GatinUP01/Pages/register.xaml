<Page x:Class="GatinUP01.Pages.register"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GatinUP01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="960"
      Title="register">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Rectangle Grid.Row="0" Fill="LightGray" HorizontalAlignment="Stretch"/>
        
        <Label Content="Регистрация"
               Grid.Row="0" 
               Height="40" Width="320"
               FontSize="20"
               HorizontalContentAlignment="Center"
               VerticalContentAlignment="Center"/>
        

        <Label Content="Имя" 
               HorizontalAlignment="Center" 
               Margin="0,219,0,0" 
               Grid.Row="1" 
               VerticalAlignment="Top" 
               Width="560"/>

        <TextBox x:Name="Input_Name"
                 HorizontalAlignment="Center" 
                 FontSize="16" 
                 Margin="0,251,0,0" 
                 Grid.Row="1" 
                 TextWrapping="Wrap" 
                 Text="" 
                 VerticalAlignment="Top" 
                 Width="560" Height="42"
                 VerticalContentAlignment="Center"/>

        <TextBox x:Name="Input_Login"
                 HorizontalAlignment="Left" 
                 FontSize="16" 
                 Margin="200,334,0,0" 
                 Grid.Row="1" 
                 TextWrapping="Wrap" 
                 Text="" 
                 VerticalAlignment="Top" 
                 Width="275" Height="42"
                 VerticalContentAlignment="Center"/>

        <TextBox x:Name="Input_Password"
                 HorizontalAlignment="Left" 
                 FontSize="16" 
                 Grid.Row="1" 
                 TextWrapping="Wrap" 
                 Text="" 
                 VerticalAlignment="Top" 
                 Width="275" Height="42" 
                 Margin="485,335,0,0"
                 VerticalContentAlignment="Center"/>

        <Label Content="Логин" 
               HorizontalAlignment="Left" 
               Margin="200,303,0,0" 
               Grid.Row="1" 
               VerticalAlignment="Top" 
               Width="275"/>

        <Label Content="Пароль" 
               HorizontalAlignment="Left" 
               Margin="485,303,0,0" 
               Grid.Row="1" 
               VerticalAlignment="Top" 
               Width="275"/>




        <Button x:Name="Button_Enter"
                ToolTip="Зарегистрироваться в системе"
                Content="Зарегистрироваться" 
                FontSize="16"
                HorizontalAlignment="Center" 
                Margin="0,445,0,0" 
                Grid.Row="1" 
                VerticalAlignment="Top" 
                Height="50" Width="560" Click="Button_Enter_Click"/>

        <Button x:Name="Button_Auth"
                ToolTip="Вернуться обратно на страницу авторизации"
                Content="Авторизация" 
                FontSize="16"
                HorizontalAlignment="Center" 
                Margin="0,500,0,0" 
                Grid.Row="1" 
                VerticalAlignment="Top" 
                Height="50" Width="560" Click="Button_Auth_Click"/>
    </Grid>
</Page>
