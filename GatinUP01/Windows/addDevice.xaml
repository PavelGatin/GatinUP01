<Window x:Class="GatinUP01.Windows.addDevice"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GatinUP01.Windows"
        mc:Ignorable="d"
        Title="Добавление устройства" Height="450" Width="300"
        ResizeMode="NoResize">
    
    
    <Grid>
        <TabControl x:Name="TabManualControl">
            <TabItem x:Name="Tab_Connecting" Header="Подключение">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Label x:Name="Connecting_Label"
                           Grid.Row="0"
                           Margin="1"
                           Content="Поиск устройств..." 
                           FontSize="16"
                           VerticalContentAlignment="Center"/>
                    
                    <Rectangle Grid.Row="1" Stroke="Black" Fill="LightGray"/>
                    
                    <ListBox x:Name="Connecting_List" Grid.Row="1" SelectionChanged="Connecting_List_SelectionChanged"/>
                </Grid>
            </TabItem>
            
            <TabItem x:Name="Tab_Settings" Header="Настройка">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <Image x:Name="Icon_Add"
                           Source="/Icons/settings.png"
                           HorizontalAlignment="Left" 
                           Height="50" 
                           VerticalAlignment="Center" 
                           Width="50" Margin="5,0,0,0"/>

                    <Label x:Name="Label_Type"
                           Content="(Тип датчика)" 
                           HorizontalAlignment="Left" 
                           Margin="60,5,0,0" 
                           VerticalAlignment="Top" 
                           Width="224" 
                           Height="25"/>

                    <Label x:Name="Label_Name"
                           Content="(Название устройства)" 
                           HorizontalAlignment="Left" 
                           Margin="60,30,0,0" 
                           VerticalAlignment="Top" 
                           Width="224" Height="25"/>

                    <TextBox x:Name="Field_Name"
                             Tag="Имя устройства"
                             HorizontalAlignment="Center" 
                             Margin="0,35,0,0" 
                             Grid.Row="1" 
                             TextWrapping="Wrap" 
                             Text="" 
                             VerticalAlignment="Top" 
                             Width="274"/>

                    <TextBox x:Name="Field_Place"
                             Tag="Место/расположение устройства"
                             HorizontalAlignment="Center" 
                             Margin="0,89,0,0" 
                             Grid.Row="1" 
                             TextWrapping="Wrap" 
                             Text="" 
                             VerticalAlignment="Top" 
                             Width="274">
                        
                    </TextBox>

                    <Label Content="Имя" 
                           HorizontalAlignment="Center" 
                           Margin="0,9,0,0" 
                           Grid.Row="1" 
                           VerticalAlignment="Top" 
                           Width="274"/>

                    <Label Content="Место (необязательно)" 
                           VerticalContentAlignment="Bottom" 
                           HorizontalAlignment="Center" 
                           Margin="0,63,0,0" 
                           Grid.Row="1" 
                           VerticalAlignment="Top" 
                           Width="274"/>

                    <Button x:Name="Button_AddDevice"
                            ToolTip="Добавление устройства в систему"
                            Grid.Row="2"
                            Content="Добавить" 
                            VerticalAlignment="Top" 
                            Width="274" Click="Button_AddDevice_Click"/>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
